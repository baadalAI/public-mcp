#!/usr/bin/env python3
"""ComputeEdge webhook receiver - auto-deploy on GitHub push.
Generated by ComputeEdge. Do not edit manually.
"""
import hashlib
import hmac
import json
import logging
import subprocess
import sys
from http.server import HTTPServer, BaseHTTPRequestHandler

WEBHOOK_SECRET = "{{ webhook_secret }}"
BRANCH = "{{ branch }}"
DEPLOY_DIR = "/root/{{ deployment_id }}"
PORT = {{ webhook_port | default(9867) }}

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [webhook] %(message)s",
    handlers=[
        logging.StreamHandler(sys.stdout),
        logging.FileHandler(f"{DEPLOY_DIR}/webhook.log"),
    ],
)
log = logging.getLogger("webhook")


class WebhookHandler(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path != "/webhook":
            self.send_response(404)
            self.end_headers()
            return

        content_length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(content_length)

        # Validate HMAC-SHA256 signature
        signature = self.headers.get("X-Hub-Signature-256", "")
        if not self._verify_signature(body, signature):
            log.warning("Invalid signature from %s", self.client_address[0])
            self.send_response(403)
            self.end_headers()
            self.wfile.write(b"Invalid signature")
            return

        # Parse payload
        try:
            payload = json.loads(body)
        except json.JSONDecodeError:
            self.send_response(400)
            self.end_headers()
            return

        # Check event type
        event = self.headers.get("X-GitHub-Event", "")
        if event != "push":
            log.info("Ignoring event: %s", event)
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"Ignored")
            return

        # Check branch
        ref = payload.get("ref", "")
        if ref != f"refs/heads/{BRANCH}":
            log.info("Ignoring push to %s (watching %s)", ref, BRANCH)
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"Wrong branch")
            return

        # Trigger redeploy
        log.info("Push to %s detected, redeploying...", BRANCH)
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"Deploying")

        try:
            subprocess.run(
                ["git", "-C", f"{DEPLOY_DIR}/repo", "pull", "origin", BRANCH],
                check=True, capture_output=True, text=True, timeout=120,
            )
            subprocess.run(
                ["docker", "compose", "up", "-d", "--build"],
                cwd=DEPLOY_DIR, check=True, capture_output=True, text=True, timeout=600,
            )
            log.info("Redeploy successful")
        except subprocess.CalledProcessError as e:
            log.error("Redeploy failed: %s\nstdout: %s\nstderr: %s", e, e.stdout, e.stderr)
        except subprocess.TimeoutExpired:
            log.error("Redeploy timed out")

    def do_GET(self):
        """Health check endpoint."""
        if self.path == "/health":
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok")
            return
        self.send_response(404)
        self.end_headers()

    def _verify_signature(self, body: bytes, signature: str) -> bool:
        if not signature.startswith("sha256="):
            return False
        expected = hmac.new(
            WEBHOOK_SECRET.encode(), body, hashlib.sha256
        ).hexdigest()
        return hmac.compare_digest(f"sha256={expected}", signature)

    def log_message(self, format, *args):
        pass


if __name__ == "__main__":
    server = HTTPServer(("0.0.0.0", PORT), WebhookHandler)
    log.info("Webhook receiver listening on port %d for branch '%s'", PORT, BRANCH)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log.info("Shutting down")
        server.shutdown()
