FROM ruby:3.3-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev nodejs npm git \
    {% if system_packages %}{{ system_packages | join(" ") }}{% endif %} \
    && rm -rf /var/lib/apt/lists/*

COPY Gemfile Gemfile.lock ./
RUN bundle config set --local without 'development test' \
    && bundle install --jobs 4

COPY . .

RUN SECRET_KEY_BASE=placeholder RAILS_ENV=production \
    bundle exec rails assets:precompile 2>/dev/null || true

EXPOSE 8000

ENV RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=true

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "8000"]
