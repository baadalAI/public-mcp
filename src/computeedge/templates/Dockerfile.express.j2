{% if analysis.stack.package_manager == "bun" -%}
FROM oven/bun:1-alpine
{% else -%}
FROM node:{{ node_version | default("20", true) }}-alpine
{% endif -%}
WORKDIR /app
{% if analysis.stack.package_manager == "pnpm" -%}
RUN corepack enable
COPY pnpm-lock.yaml package.json ./
RUN pnpm install --frozen-lockfile --prod
{% elif analysis.stack.package_manager == "yarn" -%}
COPY yarn.lock package.json ./
RUN yarn install --frozen-lockfile --production
{% elif analysis.stack.package_manager == "bun" -%}
COPY bun.lockb package.json ./
RUN bun install --frozen-lockfile --production
{% else -%}
COPY package*.json ./
RUN npm ci --production
{% endif -%}
{% if extra_node_packages -%}
RUN {% if analysis.stack.package_manager == "pnpm" %}pnpm add{% elif analysis.stack.package_manager == "yarn" %}yarn add{% elif analysis.stack.package_manager == "bun" %}bun add{% else %}npm install{% endif %} {{ extra_node_packages | join(" ") }}
{% endif -%}
COPY . .
EXPOSE 3000
CMD ["node", "{{ server_entry }}"]
