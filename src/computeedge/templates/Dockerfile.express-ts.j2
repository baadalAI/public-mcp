{% if analysis.stack.package_manager == "bun" -%}
FROM oven/bun:1-alpine
{% else -%}
FROM node:{{ node_version | default("20", true) }}-alpine
{% endif -%}
WORKDIR /app
{% if analysis.stack.package_manager == "pnpm" -%}
RUN corepack enable
COPY pnpm-lock.yaml package.json ./
RUN pnpm install --frozen-lockfile
{% elif analysis.stack.package_manager == "yarn" -%}
COPY yarn.lock package.json ./
RUN yarn install --frozen-lockfile
{% elif analysis.stack.package_manager == "bun" -%}
COPY bun.lockb package.json ./
RUN bun install --frozen-lockfile
{% else -%}
COPY package*.json ./
RUN npm ci
{% endif -%}
COPY . .
RUN {% if analysis.stack.package_manager == "pnpm" %}pnpm{% elif analysis.stack.package_manager == "yarn" %}yarn{% elif analysis.stack.package_manager == "bun" %}bun{% else %}npm{% endif %} run build
EXPOSE {{ port | default(3000) }}
CMD ["node", "{{ server_entry | default('dist/index.js') }}"]
