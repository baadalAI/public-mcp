{# Unified Dockerfile: builds frontend + backend in one container with embedded nginx. #}
{# Used when both frontend and backend exist (any language combination). #}

{# ===== Stage 1: Build frontend ===== #}
{% if analysis.stack.package_manager == "bun" -%}
FROM oven/bun:1-alpine AS frontend-builder
{% else -%}
FROM node:{{ node_version | default("20", true) }}-alpine AS frontend-builder
{% endif -%}
WORKDIR /build
{% set fe = frontend_path | default(".") -%}
{% set pm = analysis.stack.package_manager | default("npm") -%}
{% if pm == "pnpm" -%}
RUN corepack enable
COPY {{ fe }}/pnpm-lock.yaml {{ fe }}/package.json ./
RUN pnpm install --frozen-lockfile
{% elif pm == "yarn" -%}
COPY {{ fe }}/yarn.lock {{ fe }}/package.json ./
RUN yarn install --frozen-lockfile
{% elif pm == "bun" -%}
COPY {{ fe }}/bun.lockb {{ fe }}/package.json ./
RUN bun install --frozen-lockfile
{% else -%}
COPY {{ fe }}/package*.json ./
RUN npm ci
{% endif -%}
COPY {{ fe }}/ .
RUN {{ pm }} run build

{# ===== Stage 2: Backend runtime with embedded nginx ===== #}
{% set be = backend_path | default(".") -%}
{% if backend_language == "python" -%}
FROM python:{{ python_version | default("3.11", true) }}-slim
WORKDIR /app
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    nginx \
    {% if system_packages %}{{ system_packages | join(" ") }} {% endif %}\
    && rm -rf /var/lib/apt/lists/*
{% if has_requirements_txt -%}
COPY {{ be }}/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt{% if extra_packages %} {{ extra_packages | join(" ") }}{% endif %}

{% else -%}
COPY {{ be }}/pyproject.toml .
RUN pip install --no-cache-dir .{% if extra_packages %}{% for pkg in extra_packages %} && pip install --no-cache-dir {{ pkg }}{% endfor %}{% endif %}

{% endif -%}
COPY {{ be }}/ .
{% if build_cmd -%}
RUN {{ build_cmd }}
{% endif -%}

{% elif backend_language in ["javascript", "typescript"] -%}
{% if pm == "bun" -%}
FROM oven/bun:1-alpine
{% else -%}
FROM node:{{ node_version | default("20", true) }}-alpine
{% endif -%}
WORKDIR /app
RUN apk add --no-cache nginx
{% if pm == "pnpm" -%}
RUN corepack enable
COPY {{ be }}/pnpm-lock.yaml {{ be }}/package.json ./
RUN pnpm install --frozen-lockfile --prod
{% elif pm == "yarn" -%}
COPY {{ be }}/yarn.lock {{ be }}/package.json ./
RUN yarn install --frozen-lockfile --production
{% elif pm == "bun" -%}
COPY {{ be }}/bun.lockb {{ be }}/package.json ./
RUN bun install --frozen-lockfile --production
{% else -%}
COPY {{ be }}/package*.json ./
RUN npm ci --production
{% endif -%}
{% if extra_node_packages -%}
RUN {{ pm }} {% if pm == "yarn" %}add{% elif pm == "bun" %}add{% else %}install{% endif %} {{ extra_node_packages | join(" ") }}
{% endif -%}
COPY {{ be }}/ .

{% elif backend_language == "go" -%}
FROM golang:{{ go_version | default("1.22", true) }}-alpine AS go-builder
WORKDIR /build
COPY {{ be }}/go.* ./
RUN go mod download
COPY {{ be }}/ .
RUN CGO_ENABLED=0 go build -o /app-binary {{ entry_point | default(".") }}

FROM alpine:3.19
WORKDIR /app
RUN apk add --no-cache nginx
COPY --from=go-builder /app-binary ./server
{% else -%}
{# Fallback: unsupported backend language — fail loudly at build time #}
FROM alpine:3.19
WORKDIR /app
RUN apk add --no-cache nginx
RUN echo "ERROR: unsupported backend_language '{{ backend_language }}' for unified Dockerfile" && exit 1
{% endif %}

{# ===== Copy built frontend assets ===== #}
COPY --from=frontend-builder /build/{{ build_output_dir | default("dist") }} /var/www/html

{# ===== Embedded nginx config ===== #}
{% if backend_language == "python" -%}
RUN rm -f /etc/nginx/sites-enabled/default && \
    printf 'server {\n    listen 80;\n    location / {\n        root /var/www/html;\n        try_files $uri $uri/ /index.html;\n    }\n    location /api {\n        proxy_pass http://127.0.0.1:{{ backend_port }};\n        proxy_http_version 1.1;\n        proxy_set_header Upgrade $http_upgrade;\n        proxy_set_header Connection "upgrade";\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n}\n' > /etc/nginx/conf.d/app.conf
{% else -%}
RUN printf 'server {\n    listen 80;\n    location / {\n        root /var/www/html;\n        try_files $uri $uri/ /index.html;\n    }\n    location /api {\n        proxy_pass http://127.0.0.1:{{ backend_port }};\n        proxy_http_version 1.1;\n        proxy_set_header Upgrade $http_upgrade;\n        proxy_set_header Connection "upgrade";\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n    }\n}\n' > /etc/nginx/http.d/default.conf
{% endif %}

{# ===== Start script: nginx (daemon) + backend (foreground) ===== #}
RUN printf '#!/bin/sh\nnginx\nexec {{ run_cmd }}\n' > /start.sh && chmod +x /start.sh
EXPOSE 80
CMD ["/start.sh"]
