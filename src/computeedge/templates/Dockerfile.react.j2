{% if analysis.stack.package_manager == "bun" -%}
FROM oven/bun:1-alpine AS builder
{% else -%}
FROM node:{{ node_version | default("20", true) }}-alpine AS builder
{% endif -%}
WORKDIR /app
{% if analysis.stack.package_manager == "pnpm" -%}
RUN corepack enable
COPY pnpm-lock.yaml package.json ./
RUN pnpm install --frozen-lockfile
{% elif analysis.stack.package_manager == "yarn" -%}
COPY yarn.lock package.json ./
RUN yarn install --frozen-lockfile
{% elif analysis.stack.package_manager == "bun" -%}
COPY bun.lockb package.json ./
RUN bun install --frozen-lockfile
{% else -%}
COPY package*.json ./
RUN npm ci
{% endif -%}
COPY . .
RUN {% if analysis.stack.package_manager == "pnpm" %}pnpm{% elif analysis.stack.package_manager == "yarn" %}yarn{% elif analysis.stack.package_manager == "bun" %}bun{% else %}npm{% endif %} run build

FROM nginx:alpine
COPY --from=builder /app/{{ build_output_dir | default(output_dir) | default('dist') }} /usr/share/nginx/html
RUN printf 'server {\n  listen 3000;\n  location / {\n    root /usr/share/nginx/html;\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["nginx", "-g", "daemon off;"]
