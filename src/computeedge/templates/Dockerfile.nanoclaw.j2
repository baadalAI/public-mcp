{# Nanoclaw Dockerfile — used only as a reference/fallback.
   The primary deploy path for nanoclaw is native VM setup (deploy_mode: native)
   which installs Node.js + Docker directly on the server. #}
FROM node:{{ node_version | default("22", true) }}-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
{% if analysis.stack.package_manager == "pnpm" -%}
RUN corepack enable
COPY pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
{% elif analysis.stack.package_manager == "yarn" -%}
COPY yarn.lock ./
RUN yarn install --frozen-lockfile
{% elif analysis.stack.package_manager == "bun" -%}
COPY bun.lockb ./
RUN bun install --frozen-lockfile
{% else -%}
RUN npm ci
{% endif -%}

COPY . .
RUN npm run build

CMD ["node", "dist/index.js"]
