# ComputeEdge environment variables
#
# Copy to .env (gitignored) and customize for your deployment.

# Transport mode: stdio (local single-user) or sse (multi-tenant remote)
COMPUTEEDGE_TRANSPORT=sse

# SQLite database path (inside container)
COMPUTEEDGE_DB_PATH=/data/computeedge.db

# Comma-separated list of Host headers the SSE server will accept.
# Include every domain/IP:port clients will use to reach the server.
# Example: COMPUTEEDGE_ALLOWED_HOSTS="localhost:8080,mcp.example.com,1.2.3.4:8080"
COMPUTEEDGE_ALLOWED_HOSTS=localhost:8080,0.0.0.0:8080

# SSE server bind host and port
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8080
